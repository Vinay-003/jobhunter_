# ==============================================================================
# JobHunter V2 — Backend env template
# Copy to backend/.env — DO NOT commit real secrets (gitignored)
# Works for: local dev (vaflmkhzyvqmglstmadg), Render free tier, Supabase, AWS
# ==============================================================================
#
# QUICK START — LOCAL (Supabase vaflmkhzyvqmglstmadg, free)
# 1. Create Supabase project → get: Connection string (pooler 6543) + URL + service_role key + create private bucket `resumes`
# 2. cp backend/.env.example backend/.env && fill PG_DATABASE_STRING + SUPABASE_URL/KEY + JOOBLE_API_KEY
# 3. cd backend && npm ci && bun run src/db/migrate.ts   # applies 001-004 (creates resumes, sessions, etc.)
# 4. npm run build && EMBEDDING_PROVIDER=local node dist/server.js  # anass via venv, Mock otherwise
# 5. See frontend/project/.env.example for Vite vars
#
# RENDER (Blueprint free tier: backend plan: free, frontend static, no Render Postgres)
# - Set these same keys in Render Dashboard → Service → Environment (sync:false in render.yaml)
# - PG_DATABASE_STRING must be the Supabase pooler URL (same as local) — Render has no local DB
# - After first deploy, set CORS_ALLOWED_ORIGINS/FRONTEND_URL to https://<frontend>.onrender.com and VITE_API_BASE_URL to https://<backend>.onrender.com/api/v1, then redeploy frontend
#
# AWS (optional, after local works): create IAM user jobhunter-sagemaker-invoke (sagemaker:InvokeEndpoint only)
# and SageMaker Serverless endpoint jobhunter-anass-serverless (anass1209, 2048MB, MaxConcurrency 1), then set AWS_* + EMBEDDING_PROVIDER=aws
#
# ---------------------------------------------------------------------------
# Database — one of these is required (priority: PG_DATABASE_STRING > DATABASE_URL > SUPABASE_DB_URL)
# Use Supabase pooler (6543 ?pgbouncer=true) for both local and Render
# Get it from: Supabase Dashboard → Settings → Database → Connection string → URI (pooler)
# ---------------------------------------------------------------------------
PG_DATABASE_STRING=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
# SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
PG_SSL=true

# ---------------------------------------------------------------------------
# Server — local :3001, Render :10000 (Render sets PORT=10000, healthCheck /health)
# ---------------------------------------------------------------------------
PORT=3001
NODE_ENV=development
# Pin Node for Render (free tier build was on 24.14.1 default, needs nodenext): set in render.yaml NODE_VERSION=20.11.0
# NODE_VERSION=20.11.0  # set as env var in Render dashboard or render.yaml, not here

# ---------------------------------------------------------------------------
# Auth / Sessions — opaque SHA256, HttpOnly, SameSite=None in prod (cross-site onrender.com)
# ---------------------------------------------------------------------------
JWT_SECRET=change-me-to-random-32+chars-min  # openssl rand -base64 32 | tr -d '\n'  (used for legacy JWT fallback, sessions are opaque)
SESSION_COOKIE_NAME=jobhunter_session
SESSION_TTL_DAYS=7

# ---------------------------------------------------------------------------
# CORS — must match frontend origin exactly (no wildcard with credentials)
# ---------------------------------------------------------------------------
# Local: http://localhost:5173 (Vite)
# Render prod: https://<frontend>.onrender.com  e.g. https://jobhunter-r773.onrender.com
# After first blueprint deploy, copy the frontend URL from Render → set here → redeploy backend
CORS_ALLOWED_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# Supabase — Storage (private bucket `resumes`) + DB (same project as PG_DATABASE_STRING)
# ---------------------------------------------------------------------------
# Local: use your Supabase project vaflmkhzyvqmglstmadg (or new) — Settings → API → URL + service_role
#   Create Storage → New bucket `resumes` (Private, not public) — required for uploads
#   Without these, dev falls back to backend/uploads (local) with warning [supabaseStorage] — still works for /health /signup but not Supabase storage
# Render: set SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY + SUPABASE_RESUME_BUCKET=resumes in dashboard (sync:false)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_<your_service_role>  # or eyJ... JWT — from Supabase Dashboard → API → service_role
SUPABASE_RESUME_BUCKET=resumes

# ---------------------------------------------------------------------------
# Job Provider — Jooble (free: 500 req/day, we budget 450)
# ---------------------------------------------------------------------------
# Local & Render: same key (was committed b5c200c7..., rotate after). Get new at https://jooble.org/api/about
# If empty, recommendations fall back to DB cache + mock (no external call) — still shows UI
JOOBLE_API_KEY=your_jooble_api_key
JOOBLE_MAX_QUERIES_PER_REFRESH=4
JOOBLE_CALL_BUDGET=450

# ---------------------------------------------------------------------------
# Job providers — Jooble + Adzuna + JobsPipe + Remotive + Arbeitnow
# ---------------------------------------------------------------------------
# Comma list of enabled providers. Jooble runs one call per planned query;
# every other provider runs ONE call per recommendation run (credit/budget safe).
JOB_PROVIDERS=jooble,jobspipe,adzuna,remotive,arbeitnow
# Adzuna (https://developer.adzuna.com): trial plan, daily call cap
ADZUNA_APP_ID=your_adzuna_app_id
ADZUNA_APP_KEY=your_adzuna_app_key
ADZUNA_COUNTRY=in
ADZUNA_RESULTS_PER_PAGE=15
ADZUNA_CALL_BUDGET=100
# JobsPipe (https://jobspipe.dev): 1 credit per job returned, 1000 free/month
JOBSPIPE_API_KEY=your_jobspipe_key
JOBSPIPE_COUNTRY=IN
JOBSPIPE_LIMIT=15
JOBSPIPE_MONTHLY_BUDGET=1000
# Remotive public API: no key, max ~4 calls/day per their terms
REMOTIVE_DAILY_BUDGET=4
# Arbeitnow public dump (~250 jobs): filtered locally, cached longer
ARBEITNOW_CACHE_HOURS=12

# ---------------------------------------------------------------------------
# Embeddings — Local (dev, free) vs AWS SageMaker Serverless (prod, scale-to-zero)
# ---------------------------------------------------------------------------
# Local (default Mock, deterministic 384d, no download): EMBEDDING_PROVIDER=auto or mock — no AWS/Supabase needed, used for CI + /analyses/readiness (0 ML)
# Local real (anass fine-tune, 22.7M, 88M cache): EMBEDDING_PROVIDER=local  → needs venv fix:
#   cd backend/python && rm -rf venv && python3 -m venv venv && source venv/bin/activate
#   pip install torch==2.4.1 torchvision==0.19.1 --index-url https://download.pytorch.org/whl/cpu
#   pip install transformers==4.44.2 sentence-transformers==3.2.1
#   then EMBEDDING_PROVIDER=local LOCAL_EMBEDDING_MODEL=anass1209/resume-job-matcher-all-MiniLM-L6-v2 node dist/server.js
#   first JD ~2s load + 50ms/batch, uses venv python at backend/python/venv/bin/python (auto-detected)
# Render prod (SageMaker, anass, pay-per-invoke): set AWS_* + EMBEDDING_PROVIDER=aws
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id  # IAM jobhunter-sagemaker-invoke (sagemaker:InvokeEndpoint only)
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_SAGEMAKER_ENDPOINT_NAME=jobhunter-anass-serverless  # 2048MB, MaxConcurrency 1
EMBEDDING_MODEL_ID=anass1209/resume-job-matcher-all-MiniLM-L6-v2
# Local switch (before AWS): mock is default
# EMBEDDING_PROVIDER: auto | mock | local | aws
EMBEDDING_PROVIDER=auto
# USE_LOCAL_EMBEDDINGS=true  # alias for EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=anass1209/resume-job-matcher-all-MiniLM-L6-v2  # or Xenova/all-MiniLM-L6-v2 for ONNX
# -> enable: EMBEDDING_PROVIDER=local npm run dev
# -> requires: npm i @xenova/transformers onnxruntime-node if using Xenova; anass uses venv python (no extra npm)
#    first ONNX run downloads ~80MB to .cache/huggingface

# ---------------------------------------------------------------------------
# Keepalive — prevents Supabase pause after 7 days inactivity
# ---------------------------------------------------------------------------
# Public endpoint (/keepalive, /api/keepalive, /api/v1/keepalive) INSERTs into keepalive_pings.
# If set, Cloudflare Worker must send header x-keepalive-token: <KEEPALIVE_TOKEN>
# Leave empty for fully public (ok for free tier — cheap INSERT).
# KEEPALIVE_TOKEN=change-me-32+chars-optional

# ---------------------------------------------------------------------------
# Fallback / Legacy
# ---------------------------------------------------------------------------
# Local Python ML shim (legacy, not needed for V2 — V2 uses Node ONNX or SageMaker)
PYTHON_SERVICE_URL=http://localhost:5000
