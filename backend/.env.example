# Copy to backend/.env — DO NOT commit real secrets
# ---------------------------------------------------------------------------
# Database — one of these is required (priority: PG_DATABASE_STRING > DATABASE_URL > SUPABASE_DB_URL)
# ---------------------------------------------------------------------------
PG_DATABASE_STRING=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
# SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
PG_SSL=true

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=3001
NODE_ENV=development

# ---------------------------------------------------------------------------
# Auth / Sessions
# ---------------------------------------------------------------------------
JWT_SECRET=change-me-to-random-32+chars-minimum
SESSION_COOKIE_NAME=jobhunter_session
SESSION_TTL_DAYS=7

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# Supabase Storage (private bucket)
# ---------------------------------------------------------------------------
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_RESUME_BUCKET=resumes

# ---------------------------------------------------------------------------
# Job Provider — Jooble
# ---------------------------------------------------------------------------
JOOBLE_API_KEY=your_jooble_api_key
JOOBLE_MAX_QUERIES_PER_REFRESH=4
JOOBLE_CALL_BUDGET=450

# ---------------------------------------------------------------------------
# Embeddings — AWS SageMaker Serverless (prod) / Local (dev)
# ---------------------------------------------------------------------------
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_SAGEMAKER_ENDPOINT_NAME=your-sagemaker-endpoint-name
EMBEDDING_MODEL_ID=anass1209/resume-job-matcher-all-MiniLM-L6-v2
# Local real inference (before AWS): mock is default, set to local for real ONNX
# EMBEDDING_PROVIDER: auto | mock | local | aws
EMBEDDING_PROVIDER=auto
# USE_LOCAL_EMBEDDINGS=true  # alias for EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
# -> enable: EMBEDDING_PROVIDER=local npm run dev
# -> requires: cd backend && npm i @xenova/transformers onnxruntime-node
#    first run downloads ~80MB to .cache/huggingface

# ---------------------------------------------------------------------------
# Fallback / Legacy
# ---------------------------------------------------------------------------
# Local Python ML shim (legacy, not needed for V2 — V2 uses Node ONNX or SageMaker)
PYTHON_SERVICE_URL=http://localhost:5000
