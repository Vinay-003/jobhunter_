# =============================================================================
# JobHunter V2 — Frontend env template (Vite, build-time, public)
# Copy to frontend/project/.env — DO NOT commit real URLs if private, but these are not secrets (VITE_ is public)
# =============================================================================
#
# LOCAL DEV (Vite :5173 → Express :3001)
#   VITE_API_BASE_URL=http://localhost:3001/api/v1
#   VITE_API_URL=http://localhost:3001/api         # legacy alias, keep in sync
#   npm run dev  (expects backend at :3001 with CORS_ALLOWED_ORIGINS=http://localhost:5173)
#
# RENDER PROD (blueprint free tier: web backend + web static frontend)
#   After first blueprint Apply, Render assigns:
#     Backend: https://jobhunter-backend-lkkf.onrender.com  (or https://jobhunter-backend-<hash>.onrender.com)
#     Frontend: https://jobhunter-r773.onrender.com
#   Then in Render Dashboard → Services:
#     Backend → Environment → CORS_ALLOWED_ORIGINS=https://jobhunter-r773.onrender.com
#                            FRONTEND_URL=https://jobhunter-r773.onrender.com
#     Frontend → Environment → VITE_API_BASE_URL=https://jobhunter-backend-lkkf.onrender.com/api/v1
#                              VITE_API_URL=https://jobhunter-backend-lkkf.onrender.com/api/v1
#   Then Manual Deploy → Clear build cache & deploy (Vite bakes VITE_ at build time)
#
# ---------------------------------------------------------------------------
# API base — must match backend CORS allowlist + healthCheck
# ---------------------------------------------------------------------------
VITE_API_BASE_URL=https://<backend>.onrender.com/api/v1
# Legacy alias (some code paths read VITE_API_URL)
VITE_API_URL=https://<backend>.onrender.com/api

# Local dev defaults (uncomment for local):
# VITE_API_BASE_URL=http://localhost:3001/api/v1
# VITE_API_URL=http://localhost:3001/api
