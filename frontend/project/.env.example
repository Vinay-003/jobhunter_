# Copy to frontend/project/.env — no secrets (build-time only, VITE_ prefix is public)
# ---------------------------------------------------------------------------
# API base — must match backend CORS allowlist
# ---------------------------------------------------------------------------
VITE_API_BASE_URL=https://<backend>.onrender.com/api/v1
# Legacy alias (some code paths read VITE_API_URL)
VITE_API_URL=https://<backend>.onrender.com/api

# Local dev defaults:
# VITE_API_BASE_URL=http://localhost:3001/api/v1
# VITE_API_URL=http://localhost:3001/api
