{
  "installCommand": "env -u npm_config_cache_dir npm ci --include=dev",
  "buildCommand": "env -u npm_config_cache_dir npm run build",
  "rewrites": [
    {
      "source": "/api/v1/:path*",
      "destination": "https://jobhunter-backend-lkkf.onrender.com/api/v1/:path*"
    },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/api/v1/:path*",
      "headers": [
        { "key": "x-vercel-enable-rewrite-caching", "value": "0" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ]
}
