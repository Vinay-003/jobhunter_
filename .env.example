# JobHunter V2 — Environment template (root)
# Copy per-service examples: backend/.env.example and frontend/project/.env.example
# DO NOT commit real secrets. Keep .env files gitignored.
# This file is documentation-only — actual envs are per-service.
#
# Quick start (local):
#   cp backend/.env.example backend/.env
#   cp frontend/project/.env.example frontend/project/.env
#   # Fill PG_DATABASE_STRING + SUPABASE_URL/KEY + JOOBLE_API_KEY (see below)
#   cd backend && npm ci && npm run build && EMBEDDING_PROVIDER=local node dist/server.js
#   cd frontend/project && npm ci && npm run dev
#
# Prod (Render + Supabase vaflmkhzyvqmglstmadg + AWS SageMaker anass):
#   Set the same keys in Render Dashboard → Environment (sync:false in render.yaml)
#   Frontend: VITE_API_BASE_URL=https://<backend>.onrender.com/api/v1
#   Backend: PG_DATABASE_STRING, JWT_SECRET, SUPABASE_*, JOOBLE_*, CORS_ALLOWED_ORIGINS, AWS_* (see backend/.env.example)
#
# See backend/.env.example for all keys and local vs Render vs Supabase vs AWS notes.
